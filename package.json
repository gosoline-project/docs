{
  "name": "gosoline-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "code-excerpts": "bun scripts/code-excerpts.ts",
    "dev": "bun scripts/code-excerpts.ts && blume dev",
    "start": "bun scripts/code-excerpts.ts && blume dev",
    "build": "bun scripts/code-excerpts.ts && blume build && bun scripts/postbuild.ts",
    "preview": "blume preview",
    "serve": "blume preview",
    "validate": "bun scripts/code-excerpts.ts && blume validate --strict",
    "typecheck": "tsc"
  },
  "dependencies": {
    "blume": "2.2.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
